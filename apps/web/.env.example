# Copy to apps/web/.env.local and fill in. .env.local is git-ignored.
# `npm run dev:chain` rewrites the two NEXT_PUBLIC_KADEX_* cluster lines and
# KADEX_FAUCET_KEYPAIR, and keeps the rest.

# Cluster the app reads and signs against. Leave both unset to run on sample data.
NEXT_PUBLIC_KADEX_RPC_URL=
NEXT_PUBLIC_KADEX_USDC_MINT=

# local, devnet or mainnet. Optional: inferred from the RPC URL (localhost is
# local, a URL containing "devnet" is devnet, anything else is mainnet). The
# demo wallet and the faucet exist only off mainnet.
NEXT_PUBLIC_KADEX_NETWORK=

# Faucet for test clusters: a secret key as a JSON array, or a path to one.
# It pays 0.05 SOL and 1,000 test USDC to a wallet that has none, minting if it
# is the mint authority and transferring from its own account otherwise.
# Server side only, never NEXT_PUBLIC_, and never a key that holds real value.
KADEX_FAUCET_KEYPAIR=

# Collector Crypt marketplace API (api.collectorcrypt.com). Optional: raises the
# rate limit from 300 to 3,000 requests a minute. Sent as `Authorization: Bearer`.
COLLECTOR_CRYPT_API_KEY=

# Collector Crypt gacha API (gacha.collectorcrypt.com). Sent as `x-api-key`.
# With it, /api/v1/machines and /api/v1/stock return YOUR machines; without it
# only the public house machines are read. Server side only — never NEXT_PUBLIC_.
COLLECTOR_CRYPT_GACHA_API_KEY=
