# Copy to apps/web/.env.local and fill in. .env.local is git-ignored.
# `npm run dev:chain` rewrites only the two NEXT_PUBLIC_KADEX_* lines and keeps the rest.

# Cluster the app reads and signs against. Leave both unset to run on sample data.
NEXT_PUBLIC_KADEX_RPC_URL=
NEXT_PUBLIC_KADEX_USDC_MINT=

# Collector Crypt marketplace API (api.collectorcrypt.com). Optional: raises the
# rate limit from 300 to 3,000 requests a minute. Sent as `Authorization: Bearer`.
COLLECTOR_CRYPT_API_KEY=

# Collector Crypt gacha API (gacha.collectorcrypt.com). Sent as `x-api-key`.
# With it, /api/v1/machines and /api/v1/stock return YOUR machines; without it
# only the public house machines are read. Server side only — never NEXT_PUBLIC_.
COLLECTOR_CRYPT_GACHA_API_KEY=
