    {
      "name": "Pool",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "admin",
            "type": "pubkey"
          },
          {
            "name": "usdc_mint",
            "type": "pubkey"
          },
          {
            "name": "clp_mint",
            "type": "pubkey"
          },
          {
            "name": "usdc_vault",
            "type": "pubkey"
          },
          {
            "name": "fraction_mint",
            "docs": [
              "The basket's fraction mint, bound at `initialize_pool` and never",
              "changed.",
              "",
              "Issue #10 — fragmentation — is handled by this field rather than by a",
              "convention: a `Pool` has exactly one fraction mint, its PDA is derived",
              "from the USDC mint, and there is no instruction that rebinds it."
            ],
            "type": "pubkey"
          },
          {
            "name": "fraction_vault",
            "type": "pubkey"
          },
          {
            "name": "oracle",
            "type": "pubkey"
          },
          {
            "name": "perp_market",
            "docs": [
              "The perp market allowed to touch risk accounting."
            ],
            "type": "pubkey"
          },
          {
            "name": "usdc_sleeve",
            "docs": [
              "Liquid sleeve `U`, in native USDC: the LPs' money and nothing else.",
              "Winners are paid from here.",
              "",
              "`usdc_vault` holds `usdc_sleeve + margin_held + accrued_fees_protocol`."
            ],
            "type": "u64"
          },
          {
            "name": "fraction_balance",
            "docs": [
              "Card sleeve as a TOKEN QUANTITY. Its value is marked at read time."
            ],
            "type": "u64"
          },
          {
            "name": "clp_supply",
            "type": "u64"
          },
          {
            "name": "book",
            "docs": [
              "The open book, pushed by `perp` on every open and settle, marked at",
              "read time. See [`BookSnapshot`]."
            ],
            "type": {
              "defined": {
                "name": "BookSnapshot"
              }
            }
          },
          {
            "name": "bad_debt",
            "docs": [
              "Losses past a position's margin, recorded for visibility.",
              "",
              "NOT subtracted from NAV: the pool never received that money, so the",
              "sleeve already reflects it. Subtracting it again counted it twice."
            ],
            "type": "u64"
          },
          {
            "name": "margin_held",
            "docs": [
              "Trader margin sitting in `usdc_vault`, held apart from the sleeve."
            ],
            "type": "u64"
          },
          {
            "name": "accrued_fees_lp",
            "docs": [
              "Running total of the LPs' fee share, already in the sleeve. Display."
            ],
            "type": "u64"
          },
          {
            "name": "accrued_fees_protocol",
            "docs": [
              "The protocol's fee share, in the vault but not the sleeve, until",
              "`claim_protocol_fees`."
            ],
            "type": "u64"
          },
          {
            "name": "params",
            "type": {
              "defined": {
                "name": "PoolParams"
              }
            }
          },
          {
            "name": "state",
            "type": {
              "defined": {
                "name": "MarketState"
              }
            }
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "PoolParams",
      "docs": [
        "All economic configuration lives here, inside the `Pool` account.",
        "",
        "Do not scatter these numbers through the codebase. If a value has to",
        "change, it changes on the `Pool` and everyone sees the same thing."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "card_sleeve_target",
            "docs": [
              "Card sleeve target. WAD. Spec: 0.30."
            ],
            "type": "u64"
          },
          {
            "name": "phi",
            "docs": [
              "Share of the USDC sleeve committable to traders. WAD. Spec: 0.50."
            ],
            "type": "u64"
          },
          {
            "name": "delta_max",
            "docs": [
              "Adverse move the liquid sleeve must absorb. WAD. Spec: 0.30."
            ],
            "type": "u64"
          },
          {
            "name": "mu",
            "docs": [
              "Share of open interest captured in a cascade. WAD. Spec: 0.30."
            ],
            "type": "u64"
          },
          {
            "name": "delta_liq",
            "docs": [
              "Move that takes a max-leverage position to liquidation. WAD.",
              "Spec: 0.1875 (5x with 6.25% maintenance)."
            ],
            "type": "u64"
          },
          {
            "name": "base_leverage",
            "docs": [
              "Maximum leverage. WAD. Spec: 5.0."
            ],
            "type": "u64"
          },
          {
            "name": "maintenance_margin",
            "docs": [
              "Maintenance margin. WAD. Spec: 0.0625."
            ],
            "type": "u64"
          },
          {
            "name": "r0",
            "docs": [
              "Base hourly borrow rate. WAD. Spec: 0.00005 (0.005%)."
            ],
            "type": "u64"
          },
          {
            "name": "r1",
            "docs": [
              "Quadratic borrow coefficient. WAD. Spec: 0.0005 (0.05%)."
            ],
            "type": "u64"
          },
          {
            "name": "psi",
            "docs": [
              "Crowded-side borrow surcharge. WAD. Spec: 0.5."
            ],
            "type": "u64"
          },
          {
            "name": "open_close_fee_bps",
            "docs": [
              "Open and close fee, in basis points. Spec: 10."
            ],
            "type": "u16"
          },
          {
            "name": "liquidator_fee_bps",
            "docs": [
              "Liquidator reward, in basis points of notional. Spec: 100."
            ],
            "type": "u16"
          },
          {
            "name": "deposit_haircut_bps",
            "docs": [
              "Haircut on card-fraction deposits, in basis points. Spec: 300."
            ],
            "type": "u16"
          },
          {
            "name": "max_card_weight",
            "docs": [
              "Weight ceiling for a single card inside the sleeve. WAD. Spec: 0.15."
            ],
            "type": "u64"
          },
          {
            "name": "lp_fee_share_bps",
            "docs": [
              "Share of fees going to LPs, in basis points. Spec: 7500 (75%)."
            ],
            "type": "u16"
          },
          {
            "name": "reduce_only_utilization",
            "docs": [
              "Utilization at which the market goes `ReduceOnly`. WAD. Spec: 0.95."
            ],
            "type": "u64"
          },
          {
            "name": "attack_safety",
            "docs": [
              "How many times attacking must cost what it pays, at the depth ceiling.",
              "WAD. Default 2.0 — without it the ceiling has no margin at all."
            ],
            "type": "u64"
          }
        ]
      }
    },
