  "instructions": [
    {
      "name": "add_liquidity",
      "docs": [
        "Add liquidity at the current ratio, leaving the price untouched.",
        "",
        "Deepening the pool raises the open-interest ceiling downstream, which",
        "is the behaviour the depth invariant is built on."
      ],
