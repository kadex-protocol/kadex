        },
        {
          "name": "pool",
          "writable": true
        }
      ],
      "args": [
        {
          "name": "usdc",
          "type": "u64"
        }
      ]
    },
    {
      "name": "create_pool",
      "docs": [
        "Create the pool with its first liquidity.",
        "",
