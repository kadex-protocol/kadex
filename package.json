{
  "name": "kadex",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/types",
    "packages/sdk",
    "packages/oracle",
    "packages/collector-crypt",
    "apps/keeper",
    "apps/liquidator",
    "apps/web"
  ],
  "scripts": {
    "sync-keys": "mkdir -p target/deploy && cp keys/*-keypair.json target/deploy/",
    "build:programs": "node scripts/build.mjs",
    "test:rust": "cargo test --workspace",
    "test:programs": "anchor test",
    "typecheck": "tsc -b packages/types packages/oracle packages/sdk packages/collector-crypt",
    "test:cc": "tsc -b packages/types packages/collector-crypt packages/sdk && node --test tests/collector-crypt.test.mjs tests/collector-crypt-gacha.test.mjs tests/basket.test.mjs",
    "test:cc:live": "tsc -b packages/types packages/collector-crypt && node --env-file-if-exists=apps/web/.env.local --test tests/cc/gacha.live.mjs",
    "test:cc:chain": "tsc -b packages/types packages/collector-crypt && node scripts/with-validator.mjs node --test tests/cc/*.test.mjs",
    "test:integration": "tsc -b packages/types packages/sdk && node scripts/with-validator.mjs node --test --test-force-exit tests/integration/*.test.mjs",
    "devnet": "node scripts/devnet.mjs",
    "devnet:market": "node scripts/devnet-market.mjs",
    "keeper": "node scripts/service.mjs keeper",
    "liquidator": "node scripts/service.mjs liquidator",
    "test:market": "tsc -b packages/types packages/oracle packages/sdk && node --test tests/devnet-market.test.mjs",
    "test:scripts": "tsc -b packages/types packages/collector-crypt && node --test tests/scripts.test.mjs",
    "dev:chain": "node scripts/with-validator.mjs node scripts/dev-chain.mjs",
    "test:services": "tsc -b packages/types packages/sdk && node --test tests/node-config.test.mjs",
    "test:history": "tsc -b packages/types packages/sdk && node --test tests/history.test.mjs tests/activity.test.mjs",
    "test:raydium": "tsc -b packages/types packages/oracle && node --test tests/raydium.test.mjs",
    "test:parity": "tsc -b packages/types packages/sdk && node --test tests/parity.test.mjs",
    "web": "npm run dev --workspace apps/web",
    "web:build": "npm run build --workspace apps/web",
    "ab": "tsc -b packages/types packages/sdk && node scripts/ab-test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.0",
    "@solana/web3.js": "^1.95.0",
    "@solana/spl-token": "^0.4.9"
  }
}
