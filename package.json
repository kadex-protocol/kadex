{
  "name": "slab",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/types",
    "packages/sdk",
    "packages/oracle",
    "apps/keeper",
    "apps/liquidator"
  ],
  "scripts": {
    "sync-keys": "mkdir -p target/deploy && cp keys/*-keypair.json target/deploy/",
    "build:programs": "node scripts/build.mjs",
    "test:rust": "cargo test --workspace",
    "test:programs": "anchor test",
    "typecheck": "tsc -b packages/types packages/sdk packages/oracle",
    "test:integration": "node scripts/with-validator.mjs node --test tests/integration/*.test.mjs",
    "test:parity": "node --test tests/parity.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.0",
    "@solana/web3.js": "^1.95.0",
    "@solana/spl-token": "^0.4.9"
  }
}
